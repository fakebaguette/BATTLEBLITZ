gamemode adventure @a[tag=inLobby]
experience set @a[tag=inLobby] 0 levels
experience set @a[tag=inLobby] 0 points
effect give @a[tag=!practicePvp,tag=inLobby] instant_health 2 0 true
effect give @a[tag=inLobby] saturation 2 0 true
effect give @a[tag=inLobby] speed 2 0 true
effect give @a[tag=inLobby] night_vision 15 0 true

execute as @a[tag=practicePvp,tag=inLobby] run attribute @s armor base set 4
