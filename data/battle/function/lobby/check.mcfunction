scoreboard objectives add cosmeticBarrelNoise custom:open_barrel
execute as @a[scores={cosmeticBarrelNoise=1..},tag=inLobby] at @s run playsound minecraft:block.ender_chest.open master @a ^ ^-1 ^1 1 0.8
execute as @a[scores={cosmeticBarrelNoise=1..},tag=inLobby] at @s run playsound minecraft:block.amethyst_block.place master @a ^ ^-1 ^1 10 0.5
execute as @a[scores={cosmeticBarrelNoise=1..},tag=inLobby] at @s run playsound minecraft:block.amethyst_block.chime master @a ^ ^-1 ^1 10 0.5
execute as @a[scores={cosmeticBarrelNoise=1..},tag=inLobby] at @s run playsound minecraft:block.beacon.power_select master @a ^ ^-1 ^1 0.9 1.4
execute as @a[scores={cosmeticBarrelNoise=1..},tag=inLobby] at @s run playsound minecraft:entity.breeze.charge master @a ^ ^-1 ^1 0.8 2
