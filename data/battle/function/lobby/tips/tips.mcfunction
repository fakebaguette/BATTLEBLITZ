execute if score @s game_tips matches 18 run tellraw @s ["\n",{"text":"-----------------------------------------------","color":"white"},"\n",{"text":"BATTLE ","bold":true,"color":"#ff6633"},{"text":"BLITZ","bold":true,"color":"white"},{"text":" ","bold":true},{"text":"Tip 18","bold":true,"color":"gold"},"\n\nThe ",{"text":"Trapshooter's","bold":true,"color":"yellow"}," potions can be ",{"text":"hit","bold":true,"color":"red"}," mid-air by enemies, ",{"text":"disabling","bold":true,"color":"red"}," their effects.\n\n",{"text":"-----------------------------------------------","color":"white"}]

execute if score @s game_tips matches 19 run tellraw @s ["\n",{"text":"-----------------------------------------------","color":"white"},"\n",{"text":"BATTLE ","bold":true,"color":"#ff6633"},{"text":"BLITZ","bold":true,"color":"white"},{"text":" ","bold":true},{"text":"Tip 19","bold":true,"color":"gold"},"\n\nThe trap ",{"text":"placement range","color":"white"}," on ",{"text":"Trapshooter","bold":true,"color":"yellow"}," is ",{"text":"15 blocks","bold":true,"color":"dark_aqua"},", allowing you to plant traps ",{"text":"easily","bold":true,"color":"green"}," or on top of enemies.\n\n",{"text":"-----------------------------------------------","color":"white"}]

execute if score @s game_tips matches 20 run tellraw @s ["\n",{"text":"-----------------------------------------------","color":"white"},"\n",{"text":"BATTLE ","bold":true,"color":"#ff6633"},{"text":"BLITZ","bold":true,"color":"white"},{"text":" ","bold":true},{"text":"Tip 20","bold":true,"color":"gold"},"\n\nNote that the ",{"text":"Prospector's TNT","bold":true,"color":"#dfffb0"}," will not break white concrete, but ",{"text":"only","bold":true,"color":"red"}," colored concrete, making it easier to counter enemies.\n\n",{"text":"-----------------------------------------------","color":"white"}]