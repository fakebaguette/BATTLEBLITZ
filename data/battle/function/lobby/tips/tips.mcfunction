execute if score @s game_tips matches 6 run tellraw @s ["\n",{"text":"-----------------------------------------------","color":"white"},"\n",{"text":"BATTLE ","bold":true,"color":"#ff6633"},{"text":"BLITZ","bold":true,"color":"white"},{"text":" ","bold":true},{"text":"Tip 6","bold":true,"color":"gold"},"\n\nPlace blocks into your ",{"text":"offhand","bold":true,"color":"gold"}," while mining so you can quickly ",{"text":"mine ","bold":true,"color":"yellow"},{"text":"and","color":"white"},{"text":" place","bold":true,"color":"yellow"}," at the same time!\n\n",{"text":"-----------------------------------------------","color":"white"}]

execute if score @s game_tips matches 7 run tellraw @s ["\n",{"text":"-----------------------------------------------","color":"white"},"\n",{"text":"BATTLE ","bold":true,"color":"#ff6633"},{"text":"BLITZ","bold":true,"color":"white"},{"text":" ","bold":true},{"text":"Tip 7","bold":true,"color":"gold"},"\n\nUsing a ",{"text":"Teleport Pad","bold":true,"color":"blue"}," will also give you ",{"text":"resistance ","bold":true,"color":"dark_aqua"},{"text":"and ","color":"white"},"",{"text":"speed","bold":true,"color":"aqua"},{"text":", so you can use it to flank!\n\n-----------------------------------------------","color":"white"}]

