execute if score @s game_tips matches 10 run tellraw @s ["\n",{"text":"-----------------------------------------------","color":"white"},"\n",{"text":"BATTLE ","bold":true,"color":"#ff6633"},{"text":"BLITZ","bold":true,"color":"white"},{"text":" ","bold":true},{"text":"Tip 10","bold":true,"color":"gold"},"\n\nOn ",{"text":"Crypt","bold":true,"color":"#ffb868"},", the ",{"text":"Wall of Fire","bold":true,"color":"gold"},{"text":" ","color":"gold"},{"text":"always starts ","color":"white"},{"text":"20 seconds","bold":true,"color":"dark_aqua"},{"text":" into the round, but depending on the round time, it will ","color":"white"},{"text":"close in slower","color":"yellow","bold":true},{"text":".\n\n-----------------------------------------------","color":"white"}]

