execute if score @s game_tips matches 12 run tellraw @s ["\n",{"text":"-----------------------------------------------","color":"white"},"\n",{"text":"BATTLE ","bold":true,"color":"#ff6633"},{"text":"BLITZ","bold":true,"color":"white"},{"text":" ","bold":true},{"text":"Tip 12","bold":true,"color":"gold"},"\n\nOn ",{"text":"Magus","bold":true,"color":"light_purple"},", you can ",{"text":"freeze","bold":true,"color":"aqua"}," your enemies ",{"text":"twice","bold":true,"color":"gold"},"! After the first freeze ends, use your ",{"text":"remaining","bold":true,"color":"yellow"},{"text":" ","color":"yellow"},"snowball to freeze them again!\n\n",{"text":"-----------------------------------------------","color":"white"}]

