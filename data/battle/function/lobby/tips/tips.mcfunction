execute if score @s game_tips matches 1 run tellraw @s ["\n",{"text":"-----------------------------------------------","color":"white"},"\n",{"text":"BATTLE ","bold":true,"color":"#ff6633"},{"text":"BLITZ","bold":true,"color":"white"},{"text":" ","bold":true},{"text":"Tip 1","bold":true,"color":"gold"},"\n\nThere is both ",{"text":"physical","bold":true,"color":"red"}," and ",{"text":"magic","bold":true,"color":"light_purple"}," damage in this game. \n\n",{"text":"Physical damage","bold":true,"color":"red"}," are melee attacks, arrows, and most abilities that seem \"physical\". ",{"text":"Armor","bold":true,"color":"dark_aqua"},{"text":" ","color":"dark_aqua"},{"text":"and ","color":"white"},{"text":"Shields","bold":true,"color":"gold"}," are ",{"text":"effective","color":"green"}," against these and will block a % of damage.\n\n",{"text":"Magic damage","bold":true,"color":"light_purple"}," is damage that ",{"text":"ignores","color":"red"}," armor completely. ",{"text":"Shields","bold":true,"color":"gold"}," and some blocking can block a smaller percentage of this.\n\n",{"text":"-----------------------------------------------","color":"white"}]

