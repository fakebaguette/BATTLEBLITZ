execute if score @s game_tips matches 15 run tellraw @s ["\n",{"text":"-----------------------------------------------","color":"white"},"\n",{"text":"BATTLE ","bold":true,"color":"#ff6633"},{"text":"BLITZ","bold":true,"color":"white"},{"text":" ","bold":true},{"text":"Tip 15","bold":true,"color":"gold"},"\n\nOn ",{"text":"Lightwielder","bold":true,"color":"#fdfcee"},", during your ascent time, you can use your ",{"text":"jump","bold":true,"color":"green"}," or ",{"text":"crouch","bold":true,"color":"yellow"}," keys to ",{"text":"move up","bold":true,"color":"green"}," or ",{"text":"down","bold":true,"color":"yellow"},".\n\n",{"text":"-----------------------------------------------","color":"white"}]

execute if score @s game_tips matches 16 run tellraw @s ["\n",{"text":"-----------------------------------------------","color":"white"},"\n",{"text":"BATTLE ","bold":true,"color":"#ff6633"},{"text":"BLITZ","bold":true,"color":"white"},{"text":" ","bold":true},{"text":"Tip 16","bold":true,"color":"gold"},"\n\nThe spear on ",{"text":"Cavalier ","bold":true,"color":"#ffd943"},"or ",{"text":"Seacharger","bold":true,"color":"#45fe98"}," can be difficult to hit. The ",{"text":"Cavalier's","bold":true,"color":"#ffd943"}," banner will knock away enemies so you can space. The ",{"text":"Seacharger","bold":true,"color":"#45fe98"}," can try to stall with their shielding. \n\n",{"text":"-----------------------------------------------","color":"white"}]

