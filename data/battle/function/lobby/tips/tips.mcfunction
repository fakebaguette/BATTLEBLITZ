execute if score @s game_tips matches 4 run tellraw @s ["\n",{"text":"-----------------------------------------------","color":"white"},"\n",{"text":"BATTLE ","bold":true,"color":"#ff6633"},{"text":"BLITZ","bold":true,"color":"white"},{"text":" ","bold":true},{"text":"Tip 4","bold":true,"color":"gold"},"\n\nIf the ",{"text":"game bugs","bold":true,"color":"red"}," or you want to",{"text":" ","color":"yellow"},{"text":"restart a match","bold":true,"color":"yellow"},", you can use:\n\n\"/trigger ResetAll\"\n\nto start a vote to ",{"text":"reset","bold":true,"color":"red"},{"text":" ","bold":true},"the match and ",{"text":"teleport all players","bold":true,"color":"aqua"}," back to the lobby.\n\n",{"text":"-----------------------------------------------","color":"white"}]

